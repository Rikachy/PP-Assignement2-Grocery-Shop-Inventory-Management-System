<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="TOP_CENTER" spacing="15" style="-fx-padding: 50 0 0 0;" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/17.0.12" fx:controller="AddItemsController">
    <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Add new Grocery Item"> </Label>
    <HBox alignment="TOP_CENTER" spacing="10">
        <Label text="Item Name"> </Label>
        <TextField fx:id="itemNameField" maxHeight="20" maxWidth="75" text=""> </TextField>
    </HBox>
    <HBox alignment="TOP_CENTER" spacing="10">
        <Label text="Quantity"> </Label>
        <TextField fx:id="itemQuantityField" maxHeight="20" maxWidth="75" text=""> </TextField>
    </HBox>
    <HBox alignment="TOP_CENTER" prefHeight="0.0" prefWidth="0.0" spacing="10">
        <Button maxHeight="20" maxWidth="100" onAction="#save" text="Save" />
        <Button maxHeight="20" maxWidth="100" onAction="#close" text="Close" />
    </HBox>
</VBox>
